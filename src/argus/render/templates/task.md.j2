---
id: {{ id }}
title: {{ title | j }}
assignee: {{ triage.assignee }}
severity: {{ severity }}
status: {{ status }}
component: {{ incident.component }}
labels: [argus, {{ incident.component }}, {{ severity | lower }}{% if triage.needs_human %}, needs-human{% endif %}{% if repeats %}, recurring{% endif %}]
started_at: {{ incident.start | ts }}
detected_at: {{ incident.detected_at | ts }}
resolved_at: {{ (incident.resolved_at | ts) if incident.resolved_at else "null" }}
time_to_detect_min: {{ ttd }}
affected_clients: {{ incident.impact.clients }}
peak_error_rate: {{ "%.5f" | format(incident.impact.peak_error_rate) }}
fingerprint: {{ fingerprint | j }}
votes: {{ triage.votes | j }}
analysis: {{ (triage.source ~ (" (" ~ triage.model ~ ")" if triage.model else "")) | j }}
verification: {{ "partial" if triage.unverified else "ok" }}
postmortem: {{ postmortem_path }}
---

